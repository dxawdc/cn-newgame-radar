# Web 服务与数据目录
NEWGAME_DB=data/newgame_monitor.db
NEWGAME_ICON_DIR=data/icons
NEWGAME_SCREENSHOT_DIR=data/screenshots
NEWGAME_BASE_PATH=
NEWGAME_COOKIE_SECURE=0

# 首次启动必须自行设置；不要使用示例值部署生产环境
NEWGAME_BOOTSTRAP_USERNAME=change-me
NEWGAME_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password

# 认证策略（可选）
NEWGAME_PASSWORD_ITERATIONS=600000
NEWGAME_SESSION_DAYS=30
NEWGAME_LOGIN_MAX_FAILURES=5
NEWGAME_LOGIN_WINDOW_MINUTES=15

# Android / 模拟器采集（可选）
NEWGAME_ADB=C:\path\to\adb.exe
NEWGAME_ADB_SERIAL=127.0.0.1:16384
NEWGAME_REFRESH_HUAWEI=0
NEWGAME_UI_DETAILS=0
