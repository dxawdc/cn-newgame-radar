[Unit]
Description=国内新游监控每日采集
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=newgame-monitor
Group=newgame-monitor
WorkingDirectory=/opt/newgame-monitor/current
Environment=PYTHONPATH=/opt/newgame-monitor/current/src
Environment=TZ=Asia/Shanghai
Environment=NEWGAME_DB=/var/lib/newgame-monitor/data/newgame_monitor.db
Environment=NEWGAME_ICON_DIR=/var/lib/newgame-monitor/data/icons
Environment=NEWGAME_SCREENSHOT_DIR=/var/lib/newgame-monitor/data/screenshots
ExecStart=/usr/bin/flock -n /run/lock/newgame-monitor-collector.lock /opt/newgame-monitor/venv/bin/python -m newgame_monitor.cli --sources ios-cn xiaomi vivo 4399 233 3839 --db /var/lib/newgame-monitor/data/newgame_monitor.db --raw-dir /var/lib/newgame-monitor/raw --icon-dir /var/lib/newgame-monitor/data/icons --screenshot-dir /var/lib/newgame-monitor/data/screenshots
TimeoutStartSec=3h
Nice=10

[Install]
WantedBy=multi-user.target
